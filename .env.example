# Copy this file to .env and fill in your real key to turn on AI recipe import
# (URL pages without a recipe schema, and photo transcription).
#
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
# Without this set, URL import still works for most recipe blogs (they embed
# structured data we can read directly) — but photo import and messy pages
# will fall back to "fill this in manually" instead of parsing automatically.

ANTHROPIC_API_KEY=sk-REPLACE-ME
